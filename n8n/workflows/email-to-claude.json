{
  "id": "email-to-claude-offers",
  "name": "Email to Claude - Offers",
  "nodes": [
    {
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "options": {}
      },
      "id": "1f1a2b3c-0001-4a1a-8a1a-000000000001",
      "name": "New Offer Email",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [-560, 0],
      "credentials": {
        "imap": {
          "id": "1",
          "name": "IMAP account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "sender-check",
              "leftValue": "={{ $json.from }}",
              "rightValue": "farmaciaalbinyana@gmail.com",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1f1a2b3c-0002-4a1a-8a1a-000000000002",
      "name": "Is From Offers Mailbox",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [-336, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/v1/claude/offer",
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{ `/add-offer\n\nEmail subject: ${$json.subject}\n\nEmail body:\n${$json.textPlain}` }}"
            },
            {
              "name": "subject",
              "value": "={{ `Offer update: ${$json.subject}` }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "1f1a2b3c-0003-4a1a-8a1a-000000000003",
      "name": "Call Runner /offer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-112, 0],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 60000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Header Auth account"
        }
      }
    }
  ],
  "connections": {
    "New Offer Email": {
      "main": [
        [
          {
            "node": "Is From Offers Mailbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is From Offers Mailbox": {
      "main": [
        [
          {
            "node": "Call Runner /offer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
