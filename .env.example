PORT=3000
# Loopback-only by default so the webhook isn't reachable from the LAN. On
# native Linux Docker (not Docker Desktop), host.docker.internal resolves to
# the bridge gateway, not loopback, so set HOST=0.0.0.0 there instead.
HOST=127.0.0.1
AUTH_TOKEN=your_super_secure_token_here
PROJECT_PATH=/absolute/path/to/your/repository
MAX_FILE_SIZE=20mb
# Testing only: skip git add/commit/push, just run claude. Leave unset/false normally.
SKIP_GIT=false
